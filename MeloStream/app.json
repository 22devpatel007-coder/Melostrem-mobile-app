{
  "expo": {
    "name": "MeloStream",
    "slug": "melostream-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yourcompany.melostream",
      "infoPlist": {
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "package": "com.yourcompany.melostream",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/adaptive-icon.png",
        "backgroundColor": "#0F0F0F"
      },
      "permissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "plugins": [
      "expo-dev-client",
      "expo-updates",
      "expo-font",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "newArchEnabled": false
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0F0F0F"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f710a7a1-ce5f-4f24-b4c6-9f313ffd9ab9"
      }
    },
    "owner": "devv20",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f710a7a1-ce5f-4f24-b4c6-9f313ffd9ab9",
      "enabled": true,
      "fallbackToCacheTimeout": 0
    }
  }
}